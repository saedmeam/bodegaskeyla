<?xml version="1.0" encoding="UTF-8"?>
<!-- v105.10: Reporte de Despacho Masivo (Picking List) - AJUSTE DE MÁRGENES DE SEGURIDAD -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="despacho_masivo" pageWidth="595" pageHeight="842" columnWidth="280" leftMargin="35" rightMargin="280" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[]]>
	</queryString>

	<!-- Campos de Cabecera -->
	<field name="pedidoId" class="java.lang.String"/>
	<field name="ordenId" class="java.lang.String"/>
	<field name="fechaImpresion" class="java.lang.String"/>
	<field name="sucursalNombre" class="java.lang.String"/>
	<field name="ubicacionHeader" class="java.lang.String"/>
	<field name="grupoDespachoHeader" class="java.lang.String"/>
	<field name="usuarioHeader" class="java.lang.String"/>
	
	<!-- Campos de Detalle -->
	<field name="cadena1" class="java.lang.String"/>
	<field name="cadena6" class="java.lang.String"/> 
	<field name="cadena7" class="java.lang.String"/> 
	<field name="cadena9" class="java.lang.String"/> 
	<field name="cadena10" class="java.lang.String"/> 
	<field name="cadena12" class="java.lang.String"/> 

	<!-- Variable para contar productos -->
	<variable name="totalProductos" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{cadena1} != null && $F{cadena1}.trim().toUpperCase().startsWith("E") ? 1 : null]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>

	<background>
		<band splitType="Stretch"/>
	</background>

	<pageHeader>
		<band height="105" splitType="Stretch">
			<staticText>
				<reportElement x="140" y="0" width="60" height="14"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="7.5" isBold="true"/></textElement>
				<text><![CDATA[Pedido:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="200" y="0" width="80" height="14"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="7.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{pedidoId}]]></textFieldExpression>
			</textField>
			
			<staticText>
				<reportElement x="0" y="16" width="60" height="13"/>
				<textElement><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<text><![CDATA[Página No:]]></text>
			</staticText>
			<textField>
				<reportElement x="60" y="16" width="30" height="13"/>
				<textElement><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
			
			<staticText>
				<reportElement x="115" y="16" width="100" height="13"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<text><![CDATA[Orden Despacho:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="215" y="16" width="65" height="13"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{ordenId}]]></textFieldExpression>
			</textField>
			
			<staticText>
				<reportElement x="0" y="29" width="50" height="13"/>
				<textElement><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<text><![CDATA[USUARIO:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="50" y="29" width="60" height="13"/>
				<textElement><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{usuarioHeader}]]></textFieldExpression>
			</textField>
			
			<staticText>
				<reportElement x="110" y="29" width="70" height="13"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="6" isBold="true"/></textElement>
				<text><![CDATA[FECHA/HORA:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="180" y="29" width="100" height="13"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="6" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{fechaImpresion}]]></textFieldExpression>
			</textField>
			
			<staticText>
				<reportElement x="0" y="42" width="60" height="13"/>
				<textElement><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<text><![CDATA[PEDIDO DE:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="60" y="42" width="220" height="13"/>
				<textElement><font fontName="Monospaced" size="6.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{sucursalNombre}]]></textFieldExpression>
			</textField>
			
			<line>
				<reportElement x="0" y="56" width="280" height="1"/>
				<graphicElement><pen lineWidth="1.5" lineStyle="Solid"/></graphicElement>
			</line>
			
			<staticText>
				<reportElement x="0" y="59" width="60" height="14"/>
				<textElement><font fontName="Monospaced" size="8" isBold="true"/></textElement>
				<text><![CDATA[Ubicación:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="65" y="59" width="215" height="14"/>
				<textElement><font fontName="Monospaced" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{ubicacionHeader}]]></textFieldExpression>
			</textField>
			
			<staticText>
				<reportElement x="0" y="73" width="95" height="14"/>
				<textElement><font fontName="Monospaced" size="8" isBold="true"/></textElement>
				<text><![CDATA[Grupo Despacho:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="95" y="73" width="185" height="14"/>
				<textElement><font fontName="Monospaced" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{grupoDespachoHeader}]]></textFieldExpression>
			</textField>
			
			<line>
				<reportElement x="0" y="90" width="280" height="1"/>
				<graphicElement><pen lineWidth="1.5" lineStyle="Solid"/></graphicElement>
			</line>
		</band>
	</pageHeader>

	<detail>
		<!-- Registro G (Grupo) -->
		<band height="14" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{cadena1} != null && $F{cadena1}.trim().toUpperCase().startsWith("G")]]></printWhenExpression>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="280" height="12"/>
				<textElement><font fontName="Monospaced" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{cadena10}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="13" width="280" height="1"/>
				<graphicElement><pen lineWidth="1.0" lineStyle="Solid"/></graphicElement>
			</line>
		</band>
		<!-- Registro P (Línea/Laboratorio) -->
		<band height="13" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{cadena1} != null && $F{cadena1}.trim().toUpperCase().startsWith("P")]]></printWhenExpression>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="280" height="11"/>
				<textElement><font fontName="Monospaced" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{cadena10}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="12" width="280" height="1"/>
				<graphicElement><pen lineWidth="0.5" lineStyle="Solid"/></graphicElement>
			</line>
		</band>
		<!-- Registro E (Producto) -->
		<band height="11" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{cadena1} != null && $F{cadena1}.trim().toUpperCase().startsWith("E")]]></printWhenExpression>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="10" y="0" width="250" height="11"/>
				<textElement><font fontName="Monospaced" size="8" isBold="false"/></textElement>
				<textFieldExpression><![CDATA[$F{cadena10}.trim()]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="260" y="0" width="20" height="11"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="8" isBold="false"/></textElement>
				<textFieldExpression><![CDATA[$F{cadena12}]]></textFieldExpression>
			</textField>
		</band>
		<!-- Registro L (Lote) -->
		<band height="10" splitType="Stretch">
			<printWhenExpression><![CDATA[$F{cadena1} != null && $F{cadena1}.trim().toUpperCase().startsWith("L")]]></printWhenExpression>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="10" y="0" width="250" height="10"/>
				<textElement><font fontName="Monospaced" size="7" isBold="false" isItalic="true"/></textElement>
				<textFieldExpression><![CDATA[$F{cadena10}.trim()]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="260" y="0" width="20" height="10"/>
				<textElement textAlignment="Right"><font fontName="Monospaced" size="7" isBold="false"/></textElement>
				<textFieldExpression><![CDATA[$F{cadena12}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<summary>
		<band height="25" splitType="Stretch">
			<line>
				<reportElement x="0" y="3" width="280" height="1"/>
				<graphicElement><pen lineWidth="1.5" lineStyle="Solid"/></graphicElement>
			</line>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="6" width="280" height="14"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Monospaced" size="8" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["TOTAL ITEMS: " + $V{totalProductos}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
