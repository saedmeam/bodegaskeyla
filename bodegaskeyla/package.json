{
    "name": "bodegaskeyla",
    "version": "1.0.0",
    "author": "Neu360",
    "main": "main.js",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build --base-href ./",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:bodegaskeyla": "node dist/bodegaskeyla/server/server.mjs",
        "electron": "ng build --base-href ./ && electron .",
        "electron:dev": "electron .",
        "electron:build": "ng build --base-href ./ && electron-builder build --windows"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "npm@11.6.2",
    "dependencies": {
        "@angular/common": "^21.1.0",
        "@angular/compiler": "^21.1.0",
        "@angular/core": "^21.1.0",
        "@angular/forms": "^21.1.0",
        "@angular/platform-browser": "^21.1.0",
        "@angular/platform-server": "^21.1.0",
        "@angular/router": "^21.1.0",
        "@angular/ssr": "^21.1.2",
        "express": "^5.1.0",
        "rxjs": "~7.8.0",
        "tmp-promise": "^3.0.3",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.1.2",
        "@angular/cli": "^21.1.2",
        "@angular/compiler-cli": "^21.1.0",
        "@types/express": "^5.0.1",
        "@types/node": "^20.17.19",
        "electron": "^40.1.0",
        "electron-builder": "^26.8.1",
        "jsdom": "^27.1.0",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    },
    "build": {
        "appId": "com.neu360.bodegaskeyla",
        "productName": "BodegasKeyla",
        "copyright": "Copyright © 2026 Neu360",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/bodegaskeyla/**/*",
            "main.js",
            "package.json",
            "preload.js",
            "encryptionService.js",
            "printer.js",
            "PrintVeris.jar",
            "encrypter-xuit.jar",
            "config.json",
            "public/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "public/logo-keyla.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "public/logo-keyla.ico",
            "uninstallerIcon": "public/logo-keyla.ico",
            "createDesktopShortcut": true,
            "shortcutName": "Bodegas Keyla"
        },
        "asar": false,
        "publish": null
    }
}
